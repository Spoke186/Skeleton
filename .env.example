# Copy to .env and fill in. .env is git-ignored and must never be committed.

# PostgreSQL connection. Development uses a managed Postgres (see docs/adr/0002).
# Production on the VPS uses a native postgresql-16 local socket (see docs/DEPLOYMENT.md).
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Sentry (optional in development; required in production)
SENTRY_DSN=
